{
  "name": "axon",
  "version": "1.0.0",
  "description": "Panel de control web self-hosted para administrar un servidor completo: puertos, proyectos, Docker, dominios y más",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "hono": "^4.4.8",
    "js-yaml": "^4.1.0",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9"
  },
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@12.5.1"
}